# 배포 서버(EC2)용 .env 예시.
# 이 파일을 /home/ubuntu/kgb-ai/.env 로 복사해 값을 채운다.
# CD 가 `docker run --env-file .env` 로 읽어 컨테이너에 환경변수로 넣는다.
#
# ⚠️ --env-file 형식 주의 — 틀리면 조용히 다른 값이 들어간다
#   - 따옴표를 쓰지 않는다. KEY="abc" 는 따옴표까지 값이 된다 (키가 틀려 호출이 401 로 실패)
#   - = 양옆에 공백을 두지 않는다
#   - 줄 끝에 주석을 붙이지 않는다. 주석은 # 로 시작하는 줄에만
#   - export 를 붙이지 않는다
#
# 값을 바꾼 뒤에는 컨테이너를 다시 띄워야 적용된다 (--env-file 은 docker run 때 한 번만 읽힌다).

# [필수] Anthropic API 키. 비어 있으면 서버가 켜지지 않는다
ANTHROPIC_API_KEY=

# [권장] 호출 기록 파일(_out/llm_calls/)을 남기지 않는다.
# 컨테이너 안에 쌓여도 재배포하면 사라진다. 호출 한 줄(모델·토큰·비용·초)은 docker logs 에 남는다
SAVE_LLM_CALLS=0

# [선택] 쓸 Claude 모델. 비우면 claude-sonnet-5
# (예전 이름 V0_LLM_MODEL 은 더 이상 읽지 않는다)
LLM_MODEL=
