name: KGB AI CD

on:
  push:
    branches:
      - main

permissions:
  contents: read
  packages: write

env:
  AWS_REGION: ap-northeast-2
  IMAGE_NAME: ghcr.io/kgb/ai

jobs:
  ai-cd:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # --------------------------------
      # Docker Image Build & Push
      # --------------------------------

      # GHCR 로그인
      # GITHUB_TOKEN은 Workflow 실행 시 GitHub가 제공
      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # Image Tag 생성
      - name: Generate Image Tag
        id: image
        run: |
          SHORT_SHA=$(echo "${GITHUB_SHA}" | cut -c1-7)
          DATE=$(TZ="Asia/Seoul" date +%Y%m%d)
          echo "tag=${SHORT_SHA}-${DATE}" >> "$GITHUB_OUTPUT"

      # AI Docker Image Build
      - name: Build Docker Image
        run: |
          docker build \
            -t "${IMAGE_NAME}:${{ steps.image.outputs.tag }}" \
            .

      # Build한 Image를 GHCR에 저장
      - name: Push Docker Image
        run: |
          docker push "${IMAGE_NAME}:${{ steps.image.outputs.tag }}"

      # --------------------------------
      # AWS Authentication
      # --------------------------------

      # GitHub Actions에서 AWS API를 호출하기 위한 인증
      # V1에서는 IAM Access Key 방식 사용
      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_AI_ACCESS_KEY }}
          aws-secret-access-key: ${{ secrets.AWS_AI_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}
    # --------------------------------
    # Deploy
    # --------------------------------

  # SSM을 통해 AI EC2에 배포 명령 전달
      - name: Send Deploy Command
        id: deploy
        env:
          IMAGE_TAG: ${{ steps.image.outputs.tag }}
          INSTANCE_ID: ${{ secrets.INSTANCE_ID }}
        run: |
          COMMAND_ID=$(aws ssm send-command \
            --instance-ids "${INSTANCE_ID}" \
            --document-name "AWS-RunShellScript" \
            --parameters "commands=[
              \"cd /home/ubuntu/kgb-ai\",
              \"docker pull ${IMAGE_NAME}:${IMAGE_TAG}\",
              \"docker rm -f kgb-ai || true\",
              \"docker run -d --name kgb-ai --restart unless-stopped -p 8000:8000 --env-file .env ${IMAGE_NAME}:${IMAGE_TAG}\",
              \"for i in \$(seq 1 10); do curl -fsS http://localhost:8000/health && exit 0; sleep 3; done; docker logs kgb-ai; exit 1\"
            ]" \
            --query "Command.CommandId" \
            --output text)
          
          echo "command_id=${COMMAND_ID}" >> "$GITHUB_OUTPUT"
      

      # SSM 명령 완료 대기
      - name: Wait for Deploy Command
        env:
          INSTANCE_ID: ${{ secrets.INSTANCE_ID }}
        run: |
          aws ssm wait command-executed \
            --command-id "${{ steps.deploy.outputs.command_id }}" \
            --instance-id "${INSTANCE_ID}" || true
      

      # 배포 결과 확인
      - name: Check Deploy Result
        env:
          INSTANCE_ID: ${{ secrets.INSTANCE_ID }}
        run: |
          STATUS=$(aws ssm get-command-invocation \
            --command-id "${{ steps.deploy.outputs.command_id }}" \
            --instance-id "${INSTANCE_ID}" \
            --query "Status" \
            --output text)
          
          echo "Deploy status: ${STATUS}"
          
          if [ "${STATUS}" != "Success" ]; then
            echo "AI deployment failed."
          
            exit 1
          fi
          
          echo "AI deployment succeeded."
