# 공공데이터포털에서 발급받은 TourAPI 서비스키
# 인코딩/디코딩 키 중 무엇이든 넣으면 스크립트가 통하는 방식을 자동 판별합니다
TOURAPI_SERVICE_KEY=

# Anthropic API 키 — V0_LLM_MODEL 이 Claude 일 때 씁니다.
ANTHROPIC_API_KEY=

# Google AI Studio API 키 — V0_LLM_MODEL 이 gemini-* 일 때 씁니다.
GEMINI_API_KEY=

# ⚠️ V0_USE_LLM 과 V0_LLM_MODEL 은 이 파일에 적어도 읽히지 않습니다.
#    이 프로젝트는 python-dotenv 를 쓰지 않습니다. .env 를 읽는 것은 API 키뿐이고
#    (v0/llm.py 의 _load_api_key), 두 값은 os.environ 만 봅니다.
#
#    실행할 때 명령 앞에 붙이세요 — 그 한 번의 실행에만 적용됩니다:
#
#      V0_USE_LLM=1 V0_LLM_MODEL=gemini-3.5-flash-lite \
#          uv run python -m v0.run --province 서울특별시 --city 중구 \
#          --start 26.10.12 --end 26.10.14 --details HISTORY_HERITAGE_SITE --human
#
#    V0_USE_LLM=1 이 없으면 무조건 가짜 구현이 돕니다 (실수로 비용이 나가지 않게).
#    V0_LLM_MODEL 은 gemini 로 시작하면 Gemini, 그 밖이면 Claude, 비우면 claude-sonnet-5.
#    요금이 기록되는 Claude 모델은 v0/llm.py 의 CLAUDE_PRICING 에 있는 것뿐입니다.
