LLM_MODE=
SAVE_MODE=
FAKE_LLM_DELAY_SEC=

# Anthropic API 키. 환경변수가 있으면 그쪽이 먼저, 없으면 이 파일에서 읽습니다.
# 로컬 테스트용 키
ANTHROPIC_API_KEY=

# 글쓰기를 누가 하나: claude(비우면) · vllm(런팟의 자체 모델). 배치는 늘 Claude
LLM_WRITE_BACKEND=
# vllm 일 때만. 예: https://<pod-id>-8000.proxy.runpod.net/v1
VLLM_BASE_URL=
# vLLM 의 --api-key. 키 없이 띄웠으면 아무 값
VLLM_API_KEY=
# vLLM 의 --served-model-name (/v1/models 에 나오는 이름)
VLLM_MODEL=
# vLLM 에 보낼 지시문: v7(비우면, 모델이 학습한 그대로) · claude(Sonnet 글쓰기 지시문)
VLLM_PROMPT=

# 백엔드 콜백 (진행 상황·결과 알림). 둘 다 비우면 보내지 않고, 하나만 있으면 시작 로그에 경고
# 예: http://<백엔드 주소>  (경로 /internal/v1/ai/generation-events 는 코드가 붙인다)
BE_CALLBACK_BASE_URL=
# 백엔드가 발급한 토큰. Authorization: Bearer 로 보낸다
AI_CALLBACK_TOKEN=
