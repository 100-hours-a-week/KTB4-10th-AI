# Anthropic API 키. 환경변수가 있으면 그것을, 없으면 이 파일을 읽습니다.
# 배포(도커)에서는 `docker run --env-file .env` 로 환경변수가 되어 들어갑니다.
# 둘 다 없으면 서버가 켜지지 않습니다.
ANTHROPIC_API_KEY=

# ⚠️ V0_USE_LLM · V0_LLM_MODEL 은 로컬 실행에서는 여기 적어도 읽히지 않습니다 — 실행 명령 앞에 붙이세요.
#    (도커 배포는 --env-file 로 환경변수가 되어 들어가므로 여기 적은 V0_LLM_MODEL 이 먹힙니다.)
#    V0_LLM_MODEL 은 서버·로컬 공통, V0_USE_LLM 은 로컬 도구 전용 (tools/fake_llm.py 참고).
